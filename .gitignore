# Dependencies & build output
node_modules
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage (not generated yet, but harmless to ignore ahead of time)
coverage

# Environment files (no backend in this mission, but keep this out of git regardless)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS shell: SwiftPM build products and the copy of dist/ that
# scripts/build-macos.sh regenerates. Committing the bundle would churn
# the repo with minified chunks on every web build — and make oxlint
# walk them.
macos/**/.build/
macos/**/.swiftpm/
macos/PlanEditorMac/Sources/PlanEditorMac/WebApp/
